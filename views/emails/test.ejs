<%- include('_header') %>

<div style="text-align: center; margin-bottom: 24px;">
    <div style="background-color: #f0f9ff; width: 56px; height: 56px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto 16px auto;">
        <span style="font-size: 28px; line-height: 56px;">✅</span>
    </div>
    <h1 style="font-size: 24px; font-weight: 700; color: #0284c7; margin: 0;">Test Submission</h1>
</div>

<p style="font-size: 16px; color: #334155; line-height: 1.6; margin-bottom: 16px;">Dear <strong><%= data.studentName %></strong>,</p>
<p style="font-size: 16px; color: #334155; line-height: 1.6; margin-bottom: 24px;">Your test submission for <strong><%= data.testTitle %></strong> has been received successfully.</p>

<div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin-bottom: 32px;">
    <table style="width: 100%; border-collapse: collapse;">
        <tr>
            <td style="padding-bottom: 12px; font-size: 14px; color: #64748b; width: 100px;">Test Title</td>
            <td style="padding-bottom: 12px; font-size: 15px; font-weight: 600; color: #0f172a;"><%= data.testTitle %></td>
        </tr>
        <tr>
            <td style="font-size: 14px; color: #64748b;">Marks Scored</td>
            <td style="font-size: 15px; font-weight: 600; color: #22c55e;"><%= data.marks %> / <%= data.totalMarks %></td>
        </tr>
    </table>
</div>

<div style="text-align: center; margin-bottom: 32px;">
    <a href="#" style="background-color: #003d7a; color: #ffffff; text-decoration: none; font-size: 15px; font-weight: 600; padding: 14px 32px; border-radius: 100px; display: inline-block;">Review Test Results</a>
</div>

<%- include('_footer') %>
