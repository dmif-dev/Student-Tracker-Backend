{
    "name": "student-tracker-backend",
    "version": "1.0.0",
    "description": "Node.js/Express API for the Student Tracker system",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "lint": "eslint .",
        "format": "prettier --write \"src/**/*.ts\"",
        "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
        "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
        "prisma:studio": "prisma studio",
        "prisma:push": "prisma db push --schema=prisma/schema.prisma",
        "prisma:seed": "tsx prisma/seed.ts",
        "db:setup": "pnpm prisma:generate && pnpm prisma:migrate && pnpm prisma:seed",
        "test:db": "tsx src/test-prisma.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@prisma/adapter-pg": "^6.0.0",
        "@prisma/client": "^6.0.0",
        "@sendgrid/mail": "^8.1.6",
        "@supabase/supabase-js": "^2.99.1",
        "@tanstack/react-query": "^5.100.9",
        "bcryptjs": "^3.0.3",
        "bull": "^4.16.5",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "ejs": "^5.0.1",
        "exceljs": "^4.4.0",
        "express": "^4.18.2",
        "express-rate-limit": "^8.3.1",
        "express-validator": "^7.3.1",
        "helmet": "^7.1.0",
        "morgan": "^1.10.0",
        "multer": "^2.1.1",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.3",
        "pdfkit": "^0.18.0",
        "pg": "^8.20.0",
        "smtp2go-nodejs": "^0.3.6",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "xlsx": "^0.18.5",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^3.0.0",
        "@types/cors": "^2.8.17",
        "@types/ejs": "^3.1.5",
        "@types/express": "^4.17.21",
        "@types/express-rate-limit": "^6.0.2",
        "@types/form-data": "^2.5.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^2.1.0",
        "@types/node": "^20.11.20",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^7.0.11",
        "@types/pdfkit": "^0.17.5",
        "@types/pg": "8.11.11",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/xlsx": "^0.0.36",
        "@typescript-eslint/eslint-plugin": "^7.0.2",
        "@typescript-eslint/parser": "^7.0.2",
        "axios": "^1.13.6",
        "bcrypt": "^6.0.0",
        "eslint": "^8.56.0",
        "form-data": "^4.0.5",
        "jsonwebtoken": "^9.0.3",
        "nodemon": "^3.1.0",
        "prettier": "^3.2.5",
        "prisma": "^6.0.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^5.3.3"
    }
}